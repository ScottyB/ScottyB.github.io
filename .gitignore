# macOS
.DS_Store

# Hugo: site output and asset pipeline cache
public/
resources/_gen/
.hugo_build.lock

# Node: any subproject under projects/<slug>/ that grows dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Built artifacts from projects/<slug>/build.mjs — regenerated by `make projects`.
static/projects/

# Generic build outputs (futureproofing for any per-project tooling)
dist/
build/
.cache/
.parcel-cache/
